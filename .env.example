# 複製此檔為 .env 後使用：cp .env.example .env
# scripts/up.sh 會自動完成這個步驟，並補上缺少的 WEBUI_SECRET_KEY。
#
# .env 已被 .gitignore 排除，請勿將真實金鑰提交進版控。

# ── 模型 ────────────────────────────────────────────────
# 第一階段預設模型。Qwen3 沒有 3B/7B 尺寸，實際為：
#   0.6b (523MB) / 1.7b (1.4GB) / 4b (2.5GB) / 8b (5.2GB) / 14b (9.3GB) ...
# 8GB RAM 的 2-core codespace 建議 4b；8b 與 Open WebUI 併跑會 OOM。
OLLAMA_MODEL=qwen3:4b

# 模型閒置後卸載的時間。縮短可釋放記憶體，但下次對話需重新載入（變慢）。
OLLAMA_KEEP_ALIVE=5m

# ── Open WebUI ──────────────────────────────────────────
# 由 scripts/up.sh 以 openssl 自動產生，請勿手動留空。
# 留空會導致 docker compose 直接拒絕啟動（這是刻意的，避免靜默失敗）。
WEBUI_SECRET_KEY=

# 註：這裡原本有一行 ENABLE_MCP。**那個環境變數不存在**（已查證官方文件與
# 後端原始碼），設了只會讓人以為 MCP 已經開啟。MCP 的啟用方式是
# Admin → External Tools → 新增 MCP (Streamable HTTP) 連線，寫進資料庫。
#
# 唯一相關的環境變數是握手逾時，慢速的 MCP server 才需要調：
# MCP_INITIALIZE_TIMEOUT=10

# 是否開放註冊。
#
# ⚠  **這個值只在第一次開機、資料庫還是空的時候有效。** 之後 Open WebUI
#    的設定存在資料庫裡，改這裡再重啟完全沒有作用 —— 這是實測結果，不是
#    推論（見 DECISIONS.md D-012）。真正要確認狀態請執行：
#        bash scripts/lock-signup.sh --check
#
#    放 false 的價值在於：將來若 volume 被重建（全新資料庫），第一次開機
#    就會是關的。它保護的是「下一次」，不是「現在」。
#
#    另外，Open WebUI 在「第一個」帳號建立時會自動把註冊關掉，而第一個
#    註冊者會成為管理員 —— 所以務必確認那是你自己。
ENABLE_SIGNUP=false

# ── Cloudflare Tunnel（選用，第二階段的對外連線）─────────
# 讓 Open WebUI 透過你自己的網域對外，並由 Cloudflare Access 決定誰能進來。
# 走這條路就不需要發布任何埠，也不必依賴 Codespaces 的埠轉送。
#
# 設定步驟：
#   1. Cloudflare Zero Trust → Networks → Tunnels → Create a tunnel
#   2. 在該 tunnel 新增 Public hostname，Service 指向 http://open-webui:8080
#      （注意是容器內的 8080，不是對外的 3000）
#   3. 複製 tunnel token（eyJ... 開頭的長字串）填到下面
#   4. Access → Applications 建立政策，例如只允許你自己的 email
#   5. 取消下面 COMPOSE_PROFILES 的註解，然後 bash scripts/up.sh
#
# Token 等同該 tunnel 的控制權，請勿提交進版控（.env 已被 .gitignore 排除）。
CLOUDFLARE_TUNNEL_TOKEN=

# 啟用 tunnel profile。註解掉 = 不啟動 cloudflared。
# 這同時也是 docker compose 的標準變數，我們的腳本會將它匯出，
# 因此 up.sh / down.sh / status.sh 都看得見這個 profile。
# COMPOSE_PROFILES=tunnel
