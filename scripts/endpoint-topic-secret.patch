+# ─── ntfy signal channel ──────────────────────────────────────────
+#
+# The topic name is a *bearer capability*: whoever knows it can read the
+# lifecycle and forge a KILL. It used to be derived from the public Kaggle
+# username, so whoever knew the account could derive it. It is now derived
+# from a local secret that never leaves this machine (D-069).
+#
+# The secret's shape is enforced, not merely documented. Knowing the topic
+# hands you an *offline verifier* for candidate secrets -- the derivation is
+# a plain hash, not a KDF -- so a short or memorable secret is genuinely
+# weak. Exactly 32 lowercase hex characters = 128 bits, matching the
+# discipline rotate-endpoint-key.sh already applies to the API key.
+
+TOPIC_SECRET_DOMAIN = "endpoint-signal-v1:"
+TOPIC_SECRET_RE = re.compile(r"[0-9a-f]{32}\Z")
+TOPIC_SECRET_HELP = (
+    "Missing or malformed signal.topic_secret in config "
+    "(want exactly 32 lowercase hex characters).\n"
+    "Run: scripts/set-endpoint-topic-secret.sh"
+)
+
+
+def topic_secret_of(config: "Config") -> str:
+    """Return the validated channel secret, or raise.
+
+    Deliberately raises instead of falling back to the old username-derived
+    topic. A fallback would be fail-open: it would silently restore the very
+    derivation this cut removes, and nothing would look wrong. This project
+    has already been bitten by that shape once (D-051).
+    """
+    secret = str(config.topic_secret or "")
+    if not TOPIC_SECRET_RE.match(secret):
+        raise ValueError(TOPIC_SECRET_HELP)
+    return secret
+
+
+def topic_digest(secret: str) -> str:
+    """The 12-hex digest naming the channel; the notebook builder mirrors it."""
+    return hashlib.sha256((TOPIC_SECRET_DOMAIN + secret).encode()).hexdigest()[:12]
+
+
 # ─── Console ──────────────────────────────────────────────────────
 
