 _CF_URL_PATTERN = re.compile(r"https://[a-zA-Z0-9-]+\.trycloudflare\.com")
 
 
+def _last_cf_url(text: str) -> str | None:
+    """Last Cloudflare quick-tunnel URL in *text*, or None."""
+    urls: list[str] = _CF_URL_PATTERN.findall(text)
+    return urls[-1] if urls else None
