+def get_kernel_log_url(config: Config) -> tuple[str, str | None]:
+    """Read the tunnel URL out of the Kaggle kernel log.
+
+    Returns ``(state, url)`` where *state* is one of:
+
+    ``"found"``
+        The log was read and contains a tunnel URL.
+    ``"absent"``
+        The log was read and contains no tunnel URL *yet*.
+    ``"unknown"``
+        The log could not be read at all: no credentials, a non-200, or a
+        network error.
+
+    "absent" is not "unknown". Collapsing the two is what let `endpoint stop`
+    read a failure-to-ask as "nothing is running" while the GPU kept burning
+    quota (D-060). Callers that *act* on the answer must keep them apart.
+
+    This replaces reading the URL off the public ntfy topic (D-068). The topic
+    name is derived from the public Kaggle username, so a URL sitting on it is
+    a URL anyone can have; the kernel log needs Kaggle credentials instead.
+    """
+    try:
+        token = get_kaggle_token()
+        if not token:
+            return ("unknown", None)
+        owner, slug = config.kernel_id.split("/", 1)
+        resp = requests.post(
+            "https://api.kaggle.com/v1/kernels.KernelsApiService/ListKernelSessionOutput",
+            json={"userName": owner, "kernelSlug": slug},
+            headers={
+                # "Authorization: Bearer" -- NOT "X-Kaggle-Authorization",
+                # which returns 403 against this endpoint.
+                "Authorization": f"Bearer {token}",
+                "Content-Type": "application/json",
+            },
+            timeout=10,
+        )
+        if resp.status_code == 200:
+            url = _last_cf_url(resp.json().get("log") or "")
+            return ("found", url) if url else ("absent", None)
+    except Exception as e:
+        console.dim(f"Kernel log read failed: {e}")
+    return ("unknown", None)
+
